# Copy this file to .env and fill in your values. Never commit .env.

# --- Claude / Anthropic API ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Model IDs (defaults are safe to leave as-is)
TRIAGE_MODEL=claude-sonnet-4-6
INTENT_MODEL=claude-haiku-4-5-20251001
JUDGE_MODEL=claude-opus-4-7

# --- Qdrant (vector store) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=motor_policy

# --- RAG parameters ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
TOP_K=5

# --- App ---
LOG_LEVEL=INFO
AUDIT_LOG_DIR=./data/audit_logs
